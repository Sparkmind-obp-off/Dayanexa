{
  "name": "dayanexa",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0",
    "build:web": "vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "build": "npm run build:web && npm run build:worker",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "test": "vitest run",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "ci": "npm run typecheck && npm test && npm run check:migrations && npm run check:secrets && npm run audit && npm run build",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply dayanexa-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply dayanexa-production --remote",
    "deploy": "npm run release:check && wrangler pages deploy dist --project-name dayanexa --branch main --commit-hash $(git rev-parse HEAD)",
    "check": "npm run typecheck && npm test && npm run check:migrations && npm run check:secrets",
    "audit": "npm audit --omit=dev --audit-level=high",
    "release:check": "node scripts/release-check.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.9",
    "@clerk/react": "^6.18.0",
    "@tanstack/react-query": "^5.90.0",
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
